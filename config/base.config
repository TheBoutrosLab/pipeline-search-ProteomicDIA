process {
    cpus = 1
    memory = 1.GB

    commonRetryCodes = [104, 134, 137, 139, 143, 247] // Common out-of-memory error codes

    errorStrategy = { task.exitStatus in (((task?.ext?.retry_codes) ? task.ext.retry_codes : []) + process.commonRetryCodes) ? 'retry' : 'terminate' }
    maxRetries = 1

}
