import nextflow.util.SysHelper

// Default inputs/parameters of the pipeline
params {
    max_cpus   = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()
    min_cpus = 1
    min_memory = 1.MB

    // This pipeline uses one process-specific allocation profile on every node.
    resource_allocation_profile_tag = 'default'

    docker_container_registry = "ghcr.io/theboutroslab"

    // Java runtime; MSFragger itself is supplied separately as a JAR.
    docker_image_java = 'eclipse-temurin:17-jre-jammy'
    openms_version = '3.5.0'
    docker_image_openms = "ghcr.io/theboutroslab/openms-thirdparty:${params.openms_version}"
    pyopenms_version = '3.5.0'
    docker_image_pyopenms = "ghcr.io/theboutroslab/pyopenms:${params.pyopenms_version}"

    decoy_prefix = 'rev_'
    save_intermediate_files = false

    // MSFragger parameter names match the keys in a fragger.params file.
    // DIA mode and unfiltered pepXML/PIN output are fixed for this first version.
    MSFragger {
        data_type = 1
        num_threads = 0
        precursor_mass_lower = -20
        precursor_mass_upper = 20
        precursor_mass_units = 1
        precursor_true_tolerance = 20
        precursor_true_units = 1
        fragment_mass_tolerance = 20
        fragment_mass_units = 1
        calibrate_mass = 2
        deisotope = 1
        deneutralloss = 1
        isotope_error = '0/1/2/3'
        precursor_mass_mode = 'selected'
        precursor_charge = '1 4'
        override_charge = 0
        require_precursor = 1
        reuse_dia_fragment_peaks = 0
        fragment_ion_series = 'b,y'
        search_enzyme_name_1 = 'stricttrypsin'
        search_enzyme_cut_1 = 'KR'
        search_enzyme_nocut_1 = ''
        search_enzyme_sense_1 = 'C'
        allowed_missed_cleavage_1 = 2
        num_enzyme_termini = 2
        clip_nTerm_M = 1
        variable_mod_01 = '15.9949 M 3'
        variable_mod_02 = '42.0106 [^ 1'
        allow_multiple_variable_mods_on_residue = 0
        max_variable_mods_per_peptide = 3
        output_format = 'pepXML_pin'
        output_report_topN = 1
        output_max_expect = 50
        digest_min_length = 7
        digest_max_length = 50
        digest_mass_range = '500.0 5000.0'
        max_fragment_charge = 2
        minimum_peaks = 15
        use_topN_peaks = 150
        min_matched_fragments = 4
        add_C_cysteine = 57.02146
    }
}

// The shared container setup checks this scope even when Singularity is unused.
singularity.enabled = false

// Standard set of profiles
profiles {
    standard {
        apptainer {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    // Define copy of default standard profile as docker to allow explicit docker selection
    // Profile aliasing isn't directly available so profile is copied
    docker {
        apptainer {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    apptainer {
        docker {
            enabled = false
        }

        apptainer {
            enabled = true

            autoMounts = true
            ociAutoPull = true
        }

        params.container_mount_flag = "-B"
    }

    local {
        docker.enabled = false
        apptainer.enabled = false
    }
}

// Process specific scope
process {
    // Process results are stored to local cache.
    // If pipeline is launched with the 'resume' option, existing cache results will be used when available
    // rather than re-executing processes
    cache = true

    // Forward process 'stdout' to shell terminal and, consequently, the log file
    debug = true
    executor = 'local'

    // Other directives or options that should apply for every process

    // Default set of resources for processes if no process- or label-specific allocations are defined for a process
    cpus = params.max_cpus
    memory = params.max_memory
}
