// EXECUTION SETTINGS AND GLOBAL DEFAULTS

// External config files import. DO NOT MODIFY THESE LINES!
includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

/**
*   Pipeline parameters
*/

params {
    dataset_id = 'dataset-01'

    param_name = 'foo-bar'

    // input/output locations
    output_dir = '/where/to/save/outputs/'
    save_intermediate_files = false
    input_csv = '/path/to/input.csv' // See input/input.csv; one unfractionated mzML per row.

    // Add other inputs/parameters here

    // Obtain the MSFragger JAR separately under its license.
    msfragger_executable = '/path/to/MSFragger.jar'

    decoy_database = '/path/to/target-decoy.fasta'
    decoy_prefix = 'rev_' // Must match the FASTA decoy identifiers.

    // Commonly adjusted MSFragger search settings. Other settings are in
    // default.config; all keys below use the native fragger.params names.
    MSFragger {
        precursor_mass_lower = -20
        precursor_mass_upper = 20
        precursor_mass_units = 1 // 0: Da; 1: ppm.
        precursor_true_tolerance = 20
        precursor_true_units = 1
        fragment_mass_tolerance = 20
        fragment_mass_units = 1
        // To search charges 1 through 5 regardless of mzML charge:
        // precursor_charge = '1 5'
        // override_charge = 1

        search_enzyme_name_1 = 'stricttrypsin'
        search_enzyme_cut_1 = 'KR'
        search_enzyme_nocut_1 = ''
        search_enzyme_sense_1 = 'C'
        allowed_missed_cleavage_1 = 2
        num_enzyme_termini = 2

        variable_mod_01 = '15.9949 M 3' // Oxidation (M).
        variable_mod_02 = '42.0106 [^ 1' // Protein N-terminal acetylation.
        add_C_cysteine = 57.02146 // Carbamidomethyl (C).
        digest_min_length = 7
        digest_max_length = 50
    }
}

// Setup the pipeline config. DO NOT REMOVE THIS LINE!
methods.setup()
