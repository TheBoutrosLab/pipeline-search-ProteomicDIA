/**
 * Write the native MSFragger-DIA parameter file.
 *
 * @input msfragger_options   val  MSFragger parameter namespace
 * @input fragger_decoy_prefix val Prefix used by decoy entries in the FASTA
 * @input decoy_database      path Target-decoy FASTA
 * @output params_file        path fragger.params
 *
 * The search process must stage the same FASTA as database.fasta beside this
 * parameter file. A relative database_name keeps the file portable between
 * Nextflow work directories and container runtimes.
 */
String renderFraggerParams(Map msfragger_options, Object fragger_decoy_prefix) {
    def options = new LinkedHashMap(msfragger_options)
    if (options.containsKey('database_name') || options.containsKey('decoy_prefix')) {
        throw new IllegalArgumentException('Set decoy_database and decoy_prefix outside params.MSFragger')
    }
    if (options.data_type != 1) {
        throw new IllegalArgumentException('This pipeline requires MSFragger.data_type = 1 (DIA)')
    }
    if (!fragger_decoy_prefix?.toString()?.trim() || fragger_decoy_prefix.toString().contains('\n') || fragger_decoy_prefix.toString().contains('\r')) {
        throw new IllegalArgumentException('decoy_prefix must be a nonempty single line')
    }

    def lines = [
        '# Generated by pipeline-search-ProteomicDIA',
        'database_name = database.fasta',
        'decoy_prefix = ' + fragger_decoy_prefix
    ]
    options.each { name, value ->
        if (!(name ==~ /[A-Za-z][A-Za-z0-9_]*/)) {
            throw new IllegalArgumentException("Invalid MSFragger parameter name: ${name}")
        }
        if (value == null || value.toString().contains('\n') || value.toString().contains('\r')) {
            throw new IllegalArgumentException("MSFragger.${name} must be a single-line value")
        }
        // An empty variable modification disables that slot.
        if (!(name ==~ /variable_mod_\d\d/ && value.toString().trim().isEmpty())) {
            lines << "${name} = ${value}"
        }
    }

    return lines.join('\n') + '\n'
}

process write_MSFraggerParams {
    label 'process_low'
    ext log_dir: { "_run/${task.process.replace(':', '/')}/task-${task.index}-attempt-${task.attempt}" }

    publishDir path: "${params.intermediate_file_dir}/MSFragger",
        mode: 'copy',
        pattern: 'fragger.params',
        enabled: params.save_intermediate_files

    input:
        val msfragger_options
        val fragger_decoy_prefix
        path decoy_database, name: 'database.fasta'

    output:
        path 'fragger.params', emit: params_file

    exec:
        file("${task.workDir}/fragger.params").text = renderFraggerParams(msfragger_options as Map, fragger_decoy_prefix)
}
