includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def testDataDir = System.getenv('TEST_DATA_DIR')
if (!testDataDir) {
    throw new IllegalArgumentException('TEST_DATA_DIR must be set for this NFTest case')
}

def sourceCsv = new File("${projectDir}/test/test-integration-fractions/input.csv")
def expandedCsv = new File("${launchDir}/input.csv")
expandedCsv.text = sourceCsv.text.replace('$TEST_DATA_DIR', testDataDir)

params {
    dataset_id = 'ECOLI_DIA_FRACTIONATED'
    input_csv = expandedCsv.absolutePath
    output_dir = System.getenv('NFT_OUTPUT') ?: "${launchDir}/output"
    decoy_database = "${testDataDir}/database/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    msfragger_executable = "${testDataDir}/MSFragger-4.4.1.jar"
    save_intermediate_files = true
}

methods.setup()

process {
    echo = false
    debug = false
}
